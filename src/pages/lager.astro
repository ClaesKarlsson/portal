---
import Base from "../layouts/Base.astro";
import { content, fyll } from "../data/site";

const page = content.lager;
---

<Base title={fyll(page.title)} description={fyll(page.description)}>
  <section class="mx-auto max-w-6xl px-5 pt-14">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-moss">{fyll(page.eyebrow)}</p>
    <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">{fyll(page.heading)}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{fyll(page.lead)}</p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-4 px-5 pt-12 sm:grid-cols-2">
    {
      page.movements.map((item) => (
        <article class="rounded-3xl border border-line bg-card p-6">
          <h2 class="font-serif text-2xl">{fyll(item.title)}</h2>
          <p class="mt-3 text-sm leading-6 text-muted">{fyll(item.text)}</p>
        </article>
      ))
    }
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-5 pt-16 lg:grid-cols-2">
    <div class="rounded-[2rem] bg-moss px-6 py-8 text-paper sm:px-8">
      <h2 class="text-3xl">{fyll(page.countHeading)}</h2>
      <p class="mt-4 leading-7 text-paper/85">{fyll(page.countText)}</p>
    </div>
    <div class="rounded-[2rem] border border-line px-6 py-8 sm:px-8">
      <h2 class="text-3xl">{fyll(page.codeHeading)}</h2>
      <p class="mt-4 leading-7 text-muted">{fyll(page.codeText)}</p>
      <a class="mt-6 inline-block text-sm font-semibold text-moss underline decoration-line underline-offset-4" href="/utrustning">
        {fyll(page.codeLink)}
      </a>
    </div>
  </section>
</Base>
