---
import Base from "../layouts/Base.astro";
import { content, fyll } from "../data/site";

const page = content.kraven;
---

<Base title={fyll(page.title)} description={fyll(page.description)}>
  <section class="mx-auto max-w-6xl px-5 pt-14">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-moss">{fyll(page.eyebrow)}</p>
    <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">{fyll(page.heading)}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{fyll(page.lead)}</p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-4 px-5 pt-12 md:grid-cols-3">
    {
      page.points.map((point) => (
        <article class="rounded-3xl border border-line bg-card p-6">
          <h2 class="font-serif text-2xl">{fyll(point.title)}</h2>
          <p class="mt-3 text-sm leading-6 text-muted">{fyll(point.text)}</p>
        </article>
      ))
    }
  </section>

  <section class="mx-auto grid max-w-6xl gap-4 px-5 pt-8 lg:grid-cols-2">
    <article class="rounded-3xl bg-ink p-6 text-paper sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-paper/60">{fyll(page.programEyebrow)}</p>
      <h2 class="mt-3 text-3xl">{fyll(page.programHeading)}</h2>
      <p class="mt-4 leading-7 text-paper/80">{fyll(page.programText)}</p>
    </article>
    <article class="rounded-3xl bg-moss p-6 text-paper sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-paper/70">{fyll(page.unitEyebrow)}</p>
      <h2 class="mt-3 text-3xl">{fyll(page.unitHeading)}</h2>
      <p class="mt-4 leading-7 text-paper/85">{fyll(page.unitText)}</p>
    </article>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-12">
    <div class="max-w-2xl rounded-3xl border border-line px-6 py-6 sm:px-8">
      <h2 class="font-serif text-2xl">{fyll(page.shopHeading)}</h2>
      <p class="mt-3 text-sm leading-7 text-muted">{fyll(page.shopText)}</p>
    </div>
    <a class="btn mt-8" href="/boka">{fyll(page.bookLabel)}</a>
  </section>
</Base>
