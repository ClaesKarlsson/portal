---
import Base from "../layouts/Base.astro";
import { content, fyll, kronor, priceKeys, site } from "../data/site";

const page = content.pris;
---

<Base title={fyll(page.title)} description={fyll(page.description)}>
  <section class="mx-auto max-w-6xl px-5 pt-14">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-moss">{fyll(page.eyebrow)}</p>
    <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">{fyll(page.heading)}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{fyll(page.lead)}</p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-10">
    <div class="overflow-hidden rounded-[1.6rem] border border-line">
      {
        page.rows.map((row, index) => (
          <article class="grid gap-3 border-b border-line bg-card px-6 py-6 last:border-b-0 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-10">
            <div>
              <h2 class="font-serif text-2xl">{fyll(row.title)}</h2>
              <p class="mt-1 text-xs font-semibold uppercase tracking-[0.14em] text-muted">{fyll(row.when)}</p>
              <p class="mt-3 max-w-xl text-sm leading-6 text-muted">{fyll(row.text)}</p>
            </div>
            <p class="font-serif text-2xl text-clay sm:text-right">{kronor(site.prices[priceKeys[index]], row.suffix)}</p>
          </article>
        ))
      }
    </div>
    <ul class="mt-6 space-y-2 text-sm leading-6 text-muted">
      {page.notes.map((note) => <li>{fyll(note)}</li>)}
    </ul>
    <a class="btn mt-8" href="/boka">{fyll(page.bookLabel)}</a>
  </section>
</Base>
