---
import Base from "../layouts/Base.astro";
import { content, fyll } from "../data/site";

const page = content.utrustning;
---

<Base title={fyll(page.title)} description={fyll(page.description)}>
  <section class="mx-auto max-w-6xl px-5 pt-14">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-moss">{fyll(page.eyebrow)}</p>
    <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">{fyll(page.heading)}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{fyll(page.lead)}</p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-12">
    <h2 class="text-3xl">{fyll(page.packHeading)}</h2>
    <ul class="mt-6 divide-y divide-line rounded-3xl border border-line bg-card">
      {
        page.pack.map((item) => (
          <li class="grid gap-1 px-6 py-5 sm:grid-cols-[12rem_1fr] sm:gap-6">
            <h3 class="font-serif text-xl">{fyll(item.title)}</h3>
            <p class="text-sm leading-6 text-muted">{fyll(item.text)}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto grid max-w-6xl gap-4 px-5 pt-8 lg:grid-cols-3">
    <article class="rounded-3xl bg-ink p-6 text-paper lg:col-span-2">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-paper/60">{fyll(page.unitEyebrow)}</p>
      <h2 class="mt-3 text-3xl">{fyll(page.unitHeading)}</h2>
      <p class="mt-4 max-w-xl leading-7 text-paper/80">{fyll(page.unitText)}</p>
    </article>
    <article class="rounded-3xl border border-line bg-card p-6">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-clay">{fyll(page.labelEyebrow)}</p>
      <h2 class="mt-3 font-serif text-2xl">{fyll(page.labelHeading)}</h2>
      <p class="mt-3 text-sm leading-6 text-muted">{fyll(page.labelText)}</p>
    </article>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-8">
    <article class="rounded-3xl border border-line px-6 py-6 sm:px-8">
      <h2 class="font-serif text-2xl">{fyll(page.terminalHeading)}</h2>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">{fyll(page.terminalText)}</p>
    </article>
    <a class="btn mt-8" href="/pris">{fyll(page.priceLink)}</a>
  </section>
</Base>
