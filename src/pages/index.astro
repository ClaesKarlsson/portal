---
import Base from "../layouts/Base.astro";
import RegisterSketch from "../components/RegisterSketch.astro";
import { content, fyll, kronor, priceKeys, site } from "../data/site";

const page = content.home;
const flowHrefs = ["/kassan", "/lager", "/kassan"];
---

<Base title={fyll(page.title)} description={fyll(page.description)}>
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-5 pt-14 lg:grid-cols-[1.05fr_0.95fr] lg:pt-20">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-moss">{fyll(page.eyebrow)}</p>
      <h1 class="mt-3 text-4xl leading-[1.05] sm:text-6xl">{fyll(page.heading)}</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-muted">{fyll(page.lead)}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn" href="/boka">{fyll(page.bookLabel)}</a>
        {site.demoUrl ? <a class="btn-secondary" href={site.demoUrl}>{fyll(page.demoLabel)}</a> : null}
        <a class="btn-secondary" href="/utrustning">{fyll(page.equipmentLabel)}</a>
      </div>
    </div>
    <RegisterSketch />
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-20">
    <h2 class="max-w-xl text-3xl leading-tight sm:text-4xl">{fyll(page.flowsHeading)}</h2>
    <ol class="mt-8 grid gap-4 md:grid-cols-3">
      {
        page.flows.map((flow, index) => (
          <li class="rounded-3xl border border-line bg-card p-6">
            <p class="text-sm font-semibold tabular-nums text-clay">{String(index + 1).padStart(2, "0")}</p>
            <h3 class="mt-3 font-serif text-2xl">{fyll(flow.title)}</h3>
            <p class="mt-3 text-sm leading-6 text-muted">{fyll(flow.text)}</p>
            <a class="mt-5 inline-block text-sm font-semibold text-moss underline decoration-line underline-offset-4" href={flowHrefs[index]}>
              {fyll(page.flowsMore)}
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-5 pt-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div>
      <h2 class="text-3xl leading-tight sm:text-4xl">{fyll(page.localHeading)}</h2>
      <p class="mt-4 text-lg leading-8 text-muted">{fyll(page.localLead)}</p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2">
      {
        page.localCards.map((card, index) => (
          <li class:list={["rounded-2xl px-5 py-4", index === 0 ? "bg-moss text-paper" : "border border-line bg-card"]}>
            <p class="font-serif text-xl">{fyll(card.title)}</p>
            <p class:list={["mt-1 text-sm leading-6", index === 0 ? "text-paper/80" : "text-muted"]}>{fyll(card.text)}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-20">
    <div class="rounded-[2rem] border border-line bg-card px-6 py-8 sm:px-10">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-moss">{fyll(page.rulesEyebrow)}</p>
      <h2 class="mt-3 max-w-2xl text-3xl leading-tight sm:text-4xl">{fyll(page.rulesHeading)}</h2>
      <p class="mt-4 max-w-2xl leading-7 text-muted">{fyll(page.rulesText)}</p>
      <a class="mt-6 inline-block text-sm font-semibold text-moss underline decoration-line underline-offset-4" href="/kraven">
        {fyll(page.rulesLink)}
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-3xl leading-tight sm:text-4xl">{fyll(page.buyHeading)}</h2>
      <a class="text-sm font-semibold text-moss underline decoration-line underline-offset-4" href="/pris">{fyll(page.buyLink)}</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        page.offer.map((item, index) => (
          <article class="rounded-3xl border border-line bg-card p-6">
            <h3 class="font-serif text-2xl">{fyll(item.title)}</h3>
            <p class="mt-2 text-sm font-semibold text-clay">{kronor(site.prices[priceKeys[index]], item.suffix)}</p>
            <p class="mt-3 text-sm leading-6 text-muted">{fyll(item.text)}</p>
          </article>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-muted">{fyll(page.buyNote)}</p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-20">
    <div class="rounded-[2rem] bg-ink px-6 py-10 text-paper sm:px-10">
      <h2 class="max-w-xl text-3xl leading-tight sm:text-4xl">{fyll(page.ctaHeading)}</h2>
      <p class="mt-4 max-w-xl text-paper/75">{fyll(page.ctaText)}</p>
      <a class="btn-light mt-8" href="/boka">{fyll(page.ctaLabel)}</a>
    </div>
  </section>
</Base>
