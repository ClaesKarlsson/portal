---
import Base from "../layouts/Base.astro";
import { content, fyll } from "../data/site";

const page = content.notFound;
---

<Base title={fyll(page.title)} description={fyll(page.description)}>
  <section class="mx-auto max-w-6xl px-5 pt-20">
    <h1 class="text-4xl sm:text-5xl">{fyll(page.heading)}</h1>
    <p class="mt-4 text-lg text-muted">{fyll(page.text)}</p>
    <a class="btn mt-8" href="/">{fyll(page.homeLabel)}</a>
  </section>
</Base>
