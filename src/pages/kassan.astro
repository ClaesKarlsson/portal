---
import Base from "../layouts/Base.astro";
import { content, fyll } from "../data/site";

const page = content.kassan;
---

<Base title={fyll(page.title)} description={fyll(page.description)}>
  <section class="mx-auto max-w-6xl px-5 pt-14">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-moss">{fyll(page.eyebrow)}</p>
    <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">{fyll(page.heading)}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{fyll(page.lead)}</p>
    <a class="mt-4 inline-block text-sm font-semibold text-moss underline decoration-line underline-offset-4" href="/kraven">{fyll(page.rulesLink)}</a>
  </section>

  <section class="mx-auto grid max-w-6xl gap-4 px-5 pt-12 md:grid-cols-3">
    {
      page.steps.map((step, index) => (
        <article class="rounded-3xl border border-line bg-card p-6">
          <p class="text-sm font-semibold tabular-nums text-clay">0{index + 1}</p>
          <h2 class="mt-3 font-serif text-2xl">{fyll(step.title)}</h2>
          <p class="mt-3 text-sm leading-6 text-muted">{fyll(step.text)}</p>
        </article>
      ))
    }
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-16">
    <h2 class="text-3xl sm:text-4xl">{fyll(page.moreHeading)}</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        page.more.map((item) => (
          <li class="rounded-3xl border border-line px-6 py-5">
            <h3 class="font-serif text-xl">{fyll(item.title)}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{fyll(item.text)}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 max-w-2xl text-sm leading-6 text-muted">{fyll(page.closing)}</p>
    <a class="btn mt-8" href="/boka">{fyll(page.bookLabel)}</a>
  </section>
</Base>
