---
import Base from "../layouts/Base.astro";
import { content, fyll, site } from "../data/site";

const page = content.support;
---

<Base title={fyll(page.title)} description={fyll(page.description)}>
  <section class="mx-auto max-w-6xl px-5 pt-14">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-moss">{fyll(page.eyebrow)}</p>
    <h1 class="mt-3 max-w-3xl text-4xl leading-tight sm:text-5xl">{fyll(page.heading)}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{fyll(page.lead)}</p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-4 px-5 pt-12 md:grid-cols-2">
    {
      page.items.map((item) => (
        <article class="rounded-3xl border border-line bg-card p-6">
          <h2 class="font-serif text-2xl">{fyll(item.title)}</h2>
          <p class="mt-3 text-sm leading-6 text-muted">{fyll(item.text)}</p>
        </article>
      ))
    }
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-12">
    <div class="rounded-[2rem] border border-line px-6 py-8 sm:px-8">
      <h2 class="text-3xl">{fyll(page.contactHeading)}</h2>
      <p class="mt-4 text-muted">{fyll(page.contactText)}</p>
      <p class="mt-4 text-lg">
        <a class="font-semibold underline decoration-line underline-offset-4" href={`tel:${site.contactPhoneHref}`}>{site.contactPhone}</a>
      </p>
      <p class="mt-1">
        <a class="underline decoration-line underline-offset-4" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      </p>
      <a class="btn mt-6" href="/boka">{fyll(page.bookLabel)}</a>
    </div>
  </section>
</Base>
