---
import Base from "../layouts/Base.astro";
import { content, fyll, site } from "../data/site";

const page = content.integritet;
---

<Base title={fyll(page.title)} description={fyll(page.description)}>
  <section class="mx-auto max-w-3xl px-5 pt-14">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-moss">{fyll(page.eyebrow)}</p>
    <h1 class="mt-3 text-4xl leading-tight sm:text-5xl">{fyll(page.heading)}</h1>
    <div class="mt-8 space-y-5 text-base leading-8 text-muted">
      {page.paragraphs.map((paragraph) => <p>{fyll(paragraph)}</p>)}
      <p>
        {fyll(page.deleteLead)}{" "}
        <a class="text-ink underline decoration-line underline-offset-4" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>{" "}
        {fyll(page.deleteTail)}
      </p>
    </div>
  </section>
</Base>
