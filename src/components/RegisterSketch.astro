---
import { content, fyll } from "../data/site";

const sketch = content.home.sketch;
---

<figure class="overflow-hidden rounded-[1.6rem] bg-ink text-paper shadow-[0_24px_60px_-30px_rgba(26,24,20,0.7)]">
  <div class="perforation" aria-hidden="true"></div>
  <div class="grid gap-6 p-5 sm:p-6 md:grid-cols-[1.4fr_0.8fr]">
    <div>
      <div class="flex items-baseline justify-between text-xs uppercase tracking-[0.16em] text-paper/60">
        <span>{fyll(sketch.kicker)}</span>
        <span>{fyll(sketch.badge)}</span>
      </div>
      <ul class="mt-4 divide-y divide-white/10 text-sm">
        {
          sketch.lines.map((line) => (
            <li class="flex justify-between py-3">
              <span>
                {fyll(line.name)}
                {line.note ? <span class="text-paper/50"> {fyll(line.note)}</span> : null}
              </span>
              <span class="tabular-nums">{fyll(line.amount)}</span>
            </li>
          ))
        }
      </ul>
      <div class="mt-2 flex items-end justify-between border-t border-white/15 pt-3">
        <span class="text-sm text-paper/70">{fyll(sketch.dueLabel)}</span>
        <span class="font-serif text-3xl tabular-nums">{fyll(sketch.dueAmount)}</span>
      </div>
      <div class="mt-4 flex flex-wrap gap-2 text-xs">
        {
          sketch.payments.map((payment, index) => (
            <span class:list={["rounded-full px-3 py-1", index === 1 ? "bg-moss" : "bg-white/10"]}>{fyll(payment)}</span>
          ))
        }
      </div>
    </div>
    <div class="rounded-2xl bg-paper p-4 text-ink">
      <p class="text-xs uppercase tracking-[0.16em] text-muted">{fyll(sketch.screenLabel)}</p>
      <p class="mt-6 font-serif text-4xl tabular-nums leading-none">{fyll(sketch.screenAmount)}</p>
      <p class="mt-3 text-sm text-muted">{fyll(sketch.screenNote)}</p>
    </div>
  </div>
  <figcaption class="border-t border-white/10 px-5 py-3 text-xs text-paper/60 sm:px-6">
    {fyll(sketch.caption)}
  </figcaption>
</figure>
