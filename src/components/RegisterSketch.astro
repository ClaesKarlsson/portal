---
import { content, fyll } from "../data/site";

const sketch = content.home.sketch;
const src = typeof sketch.src === "string" ? sketch.src : "";
const alt = fyll(typeof sketch.alt === "string" ? sketch.alt : "");
---

<figure class="overflow-hidden rounded-[1.6rem] bg-card shadow-[0_24px_60px_-30px_rgba(26,24,20,0.7)]">
  {
    src ? (
      <img class="h-full w-full object-contain" src={src} alt={alt} />
    ) : (
      <div class="flex min-h-64 items-center justify-center px-6 text-center text-sm text-muted">Bilden saknas.</div>
    )
  }
</figure>
